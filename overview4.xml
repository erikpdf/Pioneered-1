<Template>
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,0me</Size>
    <Children>
      <Template src="skin:waveforms.xml">
        <SetVariable name="channel1">1</SetVariable>
        <SetVariable name="channel2">2</SetVariable>
        <Size>0me,0me</Size>
      </Template>
      <Template src="skin:waveforms.xml">
        <SetVariable name="channel1">3</SetVariable>
        <SetVariable name="channel2">4</SetVariable>
        <Size>0me,0me</Size>
      </Template>
      
      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,150max</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,150max</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">3</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">4</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
